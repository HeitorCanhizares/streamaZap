{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "streamaZap",
  "version": "3.1.1",
  "identifier": "com.streamazap.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "streamaZap",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0A100E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0OTdGRTYwNUEwRjlFNkQKUldSdG5nOWFZUDZYUk90bDAyc3VqdloxU1ptTEJXeFJZZDh3VGkvbExyYlNQTVJQS2czLzg2d0YK",
      "endpoints": [
        "https://github.com/HeitorCanhizares/streamaZap/releases/latest/download/latest.json"
      ]
    }
  }
}
